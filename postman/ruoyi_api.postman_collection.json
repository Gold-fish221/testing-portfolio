      "name": "05 登录-SQL注入",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json();",
              "pm.test(\"注入不能登录成功\", () => pm.expect(d.code).to.not.eql(0));",
              "pm.test(\"code=500\", () => pm.expect(d.code).to.eql(500));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
